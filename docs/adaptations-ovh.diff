diff --git a/www/.htaccess b/www/.htaccess
--- a/www/.htaccess
+++ b/www/.htaccess
@@ -2,6 +2,15 @@ DirectoryIndex index.html
 
 RewriteEngine On
 
+# Temporary canonical redirect; 307 preserves request methods.
+RewriteCond %{HTTPS} !=on [OR]
+RewriteCond %{HTTP_HOST} ^www\.luminosa-cafe\.fr$ [NC]
+RewriteRule ^ https://luminosa-cafe.fr%{REQUEST_URI} [R=307,L]
+
+# Reject private paths before the React fallback.
+RewriteRule ^(?:\.env(?:\..*)?|composer\.(?:json|lock)|symfony\.lock)$ - [F]
+RewriteRule ^(?:\.git|bin|config|src|var|vendor)(?:/|$) - [F]
+
 # Only application-managed image filenames may be served from uploads.
 RewriteRule ^uploads/?$ - [F]
 RewriteRule ^uploads/(?![a-f0-9]{32}\.(?:jpg|png|webp)$) - [F]
